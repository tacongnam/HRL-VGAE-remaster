        fp1 = _compute_config_fingerprint({"epochs": 10, "seed": 42, "ablation": "HRL-VGAE"})
        fp2 = _compute_config_fingerprint({"epochs": 10, "seed": 42, "ablation": "HRL-VGAE"})
        fp3 = _compute_config_fingerprint({"epochs": 20, "seed": 42, "ablation": "HRL-VGAE"})
        self.assertEqual(fp1, fp2)
        self.assertNotEqual(fp1, fp3)

    def test_empty_front_and_accepted_zero_handling(self):
