def _make_sample_graph_and_reqs():
    G = nx.Graph()
    for u in range(5):
        is_srv = u in (1, 2, 3)
        G.add_node(
            u,
            cpu_total=1000.0 if is_srv else 0.0,
            cpu_free=1000.0 if is_srv else 0.0,
            ram_total=500.0 if is_srv else 0.0,
            ram_free=500.0 if is_srv else 0.0,
            hdd_total=500.0 if is_srv else 0.0,
            hdd_free=500.0 if is_srv else 0.0,
            is_function_node=is_srv,
            proc_delay=0.5 if is_srv else 0.0,
            cost_cpu=10.0 * u if is_srv else 0.0,
            cost_ram=2.0 if is_srv else 0.0,
            cost_stor=1.0 if is_srv else 0.0,
        )
    for u, v in [(0, 1), (1, 2), (2, 3), (3, 4), (0, 2), (1, 3), (2, 4)]:
        G.add_edge(u, v, bw_total=100.0, bw_free=100.0, delay=1.0)
    vnfs = [VNF(0, cpu_req=100.0), VNF(1, cpu_req=150.0)]
    reqs = [
        SFCRequest(sfc_id=0, source=0, dest=4, bandwidth=10.0, vnf_sequence=vnfs, deadline=30, arrival_time=0),
        SFCRequest(sfc_id=1, source=0, dest=4, bandwidth=15.0, vnf_sequence=[VNF(0, cpu_req=120.0)], deadline=40, arrival_time=1),
    ]
    return G, reqs


class HRLVGAERegressionTests(unittest.TestCase):
    def test_feature_dims_and_normalization_safety(self):
        for mode in ("HRL-VGAE", "HRL-noVGAE"):
            cfg = Config()
            cfg.train.ablation_mode = mode
            G, reqs = _make_sample_graph_and_reqs()
            env = NFVEnvironment(cfg)
            env.reset(G, reqs, topology_id="topo_test")
            feats_gen = get_node_features(env.G, cfg, 0.0)
            feats_ds = get_node_features_from_graph(env.G, cfg.vgae.d_in, 0.0)
            for f in (feats_gen, feats_ds):
                self.assertEqual(f.shape, (5, 8))
                self.assertFalse(np.isnan(f).any())
                self.assertFalse(np.isinf(f).any())
                self.assertTrue((f >= 0.0).all() and (f <= 1.0 + 1e-6).all())
                self.assertEqual(float(f[0, 7]), 0.0)
                self.assertEqual(float(f[4, 7]), 0.0)
            hl = HLAgent(cfg, torch.device("cpu"))
            ll = LLAgent(cfg, torch.device("cpu"))
            self.assertEqual(hl.q_net.trunk[0].in_features, cfg.d_hl_input)
            self.assertEqual(ll.q_net.shared[0].in_features, cfg.d_ll_input)

    def test_hrl_novgae_differentiates_candidates(self):
        cfg = Config()
        cfg.train.ablation_mode = "HRL-noVGAE"
        G, reqs = _make_sample_graph_and_reqs()
        env = NFVEnvironment(cfg)
        env.reset(G, reqs, topology_id="topo_novgae")
        env.allocate(1, [0, 1], cpu_req=400.0, bw=20.0, t_start=0.0, t_end=5.0)
        device = torch.device("cpu")
        z_nodes, z_global, _, _, _, _ = encode_graph(None, env, device, cfg)
        self.assertGreater(float(z_nodes.std()), 0.0)
        ll = LLAgent(cfg, device)
        with torch.inference_mode():
            q = ll.q_net(
                z_global.unsqueeze(0).expand(3, -1),
                z_nodes[0].unsqueeze(0).expand(3, -1),
                z_nodes[[1, 2, 3]],
                torch.tensor([[0.1]]).expand(3, -1),
                torch.zeros(3, cfg.d_sfc_full),
                torch.tensor([[0.5, 0.5]]).expand(3, -1),
            )
        self.assertGreater(float(q.std(dim=0).max()), 1e-6)

    def test_vgae_grad_flow_and_temporal_disabled(self):
        cfg = Config()
        self.assertFalse(cfg.vgae.temporal)
        G, reqs = _make_sample_graph_and_reqs()
        env = NFVEnvironment(cfg)
        env.reset(G, reqs, topology_id="topo_vgae")
        device = torch.device("cpu")
        vgae = MNVGAE(cfg).to(device)
        self.assertFalse(hasattr(vgae, "temporal_cell"))
        x, ei = env.get_node_features_tensor(device)
        z_nodes, z_global, mu, logvar = vgae(x, ei, graph_id="topo_vgae")
        pos = (z_nodes[ei[0]] * z_nodes[ei[1]]).sum(dim=-1)
        loss = torch.nn.functional.binary_cross_entropy_with_logits(pos, torch.ones_like(pos)) + vgae.kl_loss(mu, logvar)
        loss.backward()
        for name, p in vgae.named_parameters():
            if p.requires_grad:
                self.assertIsNotNone(p.grad, f"Missing grad for {name}")
                self.assertGreater(float(p.grad.abs().sum()), 0.0)

    def test_preference_conditioning_and_failure_dominance(self):
        cfg = Config()
        device = torch.device("cpu")
        hl = HLAgent(cfg, device)
        ll = LLAgent(cfg, device)
        with torch.no_grad():
            for m in (hl.q_net, hl.target_net):
                m.q_heads[0].weight.zero_()
                m.q_heads[1].weight.zero_()
                m.q_heads[0].bias.fill_(0.0)
                m.q_heads[1].bias.fill_(0.0)
        q_np = np.array([[0.9, 0.1], [0.1, 0.9]], dtype=np.float32)
        self.assertEqual(int(np.argmax(ParetoScalarizer.scalarize_q(q_np, np.array([1.0, 0.0])))), 0)
        self.assertEqual(int(np.argmax(ParetoScalarizer.scalarize_q(q_np, np.array([0.0, 1.0])))), 1)

        fail_vec = cfg.pareto.failure_penalty_vector()
        self.assertTrue((fail_vec < 0.0).all())
        for w_acc in np.linspace(0.0, 1.0, 11):
            w = np.array([w_acc, 1.0 - w_acc])
            self.assertLess(float(np.dot(fail_vec, w)), 0.0)
            self.assertGreaterEqual(float(np.dot(np.array([0.0, 0.0]), w)), 0.0)

        ll.epsilon = 0.0
        zg = torch.zeros(cfg.d_global)
        zp = torch.zeros(cfg.d_node_repr)
        z_all = torch.zeros(5, cfg.d_node_repr)
        vf = torch.zeros(cfg.qnet.d_vnf)
        sf = torch.zeros(cfg.d_sfc_full)
        mask = np.array([False, True, True, False, False])
        for i in range(cfg.qnet.batch_size):
            w = torch.tensor([1.0, 0.0] if i % 2 == 0 else [0.0, 1.0])
            s = (zg, zp, z_all[1], vf, sf, w)
            ns = (zg, z_all[1], z_all, vf, sf, mask, w)
            ll.store_transition(s, ns, np.array([0.5, 0.5], dtype=np.float32), 0.0)
        loss_val = ll.train_step()
        self.assertIsNotNone(loss_val)
        self.assertTrue(np.isfinite(loss_val))

    def test_cur_t_and_rollback_and_cache_invalidation(self):
        cfg = Config()
        G, reqs = _make_sample_graph_and_reqs()
        env = NFVEnvironment(cfg)
        env.reset(G, reqs, topology_id="topo_time")
        device = torch.device("cpu")
        f_t0, _ = env.get_node_features_tensor(device, t=0.0)
        env.allocate(1, [0, 1], cpu_req=500.0, bw=50.0, t_start=0.0, t_end=3.0)
        f_t0_alloc, _ = env.get_node_features_tensor(device, t=0.0)
        f_t3_alloc, _ = env.get_node_features_tensor(device, t=3.0)
        self.assertGreater(float(f_t0_alloc[1, 0]), float(f_t0[1, 0]))
        self.assertAlmostEqual(float(f_t3_alloc[1, 0]), 0.0, places=6)
        self.assertIsNotNone(custom_dijkstra(env.G, 0, 1, 60.0, t=3.0))
        self.assertIsNone(custom_dijkstra(env.G, 0, 1, 60.0, t=0.0))
        env.reject_sfc(reqs[0], [(1, [0, 1], 500.0, 50.0, 0.0, 0.0, 0.0, 3.0)])
        f_rb, _ = env.get_node_features_tensor(device, t=0.0)
        self.assertTrue(torch.allclose(f_t0, f_rb))
        self.assertEqual(env.get_node_cpu_free(1, 0.0), 1000.0)

    def test_pareto_indicators_and_no_fake_igd_zero(self):
        pts_norm = normalize_pareto_objectives(np.array([[0.8, 100.0], [0.9, 200.0]]), 100.0, 200.0)
        self.assertGreater(compute_hv_normalized(pts_norm, np.array([1.1, 1.1])), 0.0)
        self.assertGreaterEqual(compute_r2(pts_norm, np.array([0.0, 0.0])), 0.0)
        self.assertAlmostEqual(compute_igd_plus(pts_norm, pts_norm), 0.0, places=7)
