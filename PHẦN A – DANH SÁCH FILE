    def test_non_comparable_detection(self):
        r1 = {"status": "completed", "ablation": "HRL-VGAE", "pareto_episode": "episode_0000.json", "test_episodes": ["episode_0000.json"], "test_seed": 42, "normalization_scope": "cross_ablation", "cost_min_used": 10.0, "cost_max_used": 20.0}
