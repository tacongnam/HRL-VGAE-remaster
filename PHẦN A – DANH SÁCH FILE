    def test_statistical_aggregation_separates_seed_and_testcase_and_small_sample_guard(self):
        records = [
            {"base_instance": "nsf_c_h", "topology": "nsf", "allocation": "c", "difficulty": "h",
             "ablation": "HRL-VGAE", "seed": 42, "status": "completed", "metrics": {"mean_ar": 0.8, "hv_normalized": 0.7}},
            {"base_instance": "nsf_c_h", "topology": "nsf", "allocation": "c", "difficulty": "h",
             "ablation": "HRL-VGAE", "seed": 43, "status": "completed", "metrics": {"mean_ar": 0.9, "hv_normalized": 0.8}},
            {"base_instance": "nsf_c_h", "topology": "nsf", "allocation": "c", "difficulty": "h",
             "ablation": "HRL-VGAE", "seed": 44, "status": "completed", "metrics": {"mean_ar": 0.85, "hv_normalized": 0.75}},
            {"base_instance": "cogent_c_h", "topology": "cogent", "allocation": "c", "difficulty": "h",
             "ablation": "HRL-VGAE", "seed": 42, "status": "completed", "metrics": {"mean_ar": 0.6, "hv_normalized": None}},
            {"base_instance": "cogent_c_h", "topology": "cogent", "allocation": "c", "difficulty": "h",
             "ablation": "DefaultBaseline", "seed": 42, "status": "failed", "metrics": {}},
        ]
        agg = aggregate_experiment_records(records, metrics=("mean_ar", "hv_normalized"))
        seed_stats = agg["across_seeds_per_instance"]["nsf_c_h::HRL-VGAE"]["metrics"]["mean_ar"]
        self.assertEqual(seed_stats["n"], 3)
        self.assertAlmostEqual(seed_stats["mean"], 0.85, places=6)
        self.assertIsNotNone(seed_stats["ci95_low"])

        tc_stats = agg["across_testcases_by_ablation"]["HRL-VGAE"]["overall"]["mean_ar"]
        self.assertEqual(tc_stats["n"], 2)
        self.assertIsNone(tc_stats["ci95_low"])
        self.assertEqual(agg["across_testcases_by_ablation"]["HRL-VGAE"]["overall"]["hv_normalized"]["n"], 1)

        sig_small = paired_significance_test([0.8, 0.9, 0.85], [0.5, 0.6, 0.55])
        self.assertEqual(sig_small["status"], "insufficient_samples")
        self.assertIsNone(sig_small["significant"])
